UPDATE public."Usuarios"
SET "Password" = '$2b$10$4YmI9KjxALw/Rn56HU0rGOZJ8Xpc1utwHhAValRwolpmQfFe/Fp96'
WHERE "Usuario" = 'Coni';

UPDATE public."Usuarios"
SET "Password" = '$2b$10$XClUHPHmAcDWuFJFtfWt..hXwSUhI17pZmiP6CBMjDYyx7uLIvuXa'
WHERE "Usuario" = 'Adriana';

-- ============================================================
-- Ajuste de secuencias (el seed inserta IDs explicitos)
-- ============================================================
SELECT setval(pg_get_serial_sequence('"Roles"', 'IdRol'), (SELECT MAX("IdRol") FROM "Roles"));
SELECT setval(pg_get_serial_sequence('"Provincias"', 'IdProvincia'), (SELECT MAX("IdProvincia") FROM "Provincias"));
SELECT setval(pg_get_serial_sequence('"Ciudades"', 'IdCiudad'), (SELECT MAX("IdCiudad") FROM "Ciudades"));
SELECT setval(pg_get_serial_sequence('"Paises"', 'IdPais'), (SELECT MAX("IdPais") FROM "Paises"));
SELECT setval(pg_get_serial_sequence('"Aeropuetos"', 'IdAeropuerto'), (SELECT MAX("IdAeropuerto") FROM "Aeropuetos"));
SELECT setval(pg_get_serial_sequence('"Usuarios"', 'IdUsuario'), (SELECT MAX("IdUsuario") FROM "Usuarios"));
SELECT setval(pg_get_serial_sequence('"TiposProgramas"', 'IdTipoPrograma'), (SELECT MAX("IdTipoPrograma") FROM "TiposProgramas"));
SELECT setval(pg_get_serial_sequence('"Programa"', 'IdPrograma'), (SELECT MAX("IdPrograma") FROM "Programa"));
SELECT setval(pg_get_serial_sequence('"Institucion"', 'IdInstitucion'), (SELECT MAX("IdInstitucion") FROM "Institucion"));
SELECT setval(pg_get_serial_sequence('"Pasaportes"', 'IdPasaporte'), (SELECT MAX("IdPasaporte") FROM "Pasaportes"));
SELECT setval(pg_get_serial_sequence('"Pasajeros"', 'IdPasajero'), (SELECT MAX("IdPasajero") FROM "Pasajeros"));
SELECT setval(pg_get_serial_sequence('"Pagos"', 'IdPago'), (SELECT MAX("IdPago") FROM "Pagos"));
SELECT setval(pg_get_serial_sequence('"Vuelos"', 'IdVuelo'), (SELECT MAX("IdVuelo") FROM "Vuelos"));
SELECT setval(pg_get_serial_sequence('"Viajes"', 'IdViaje'), (SELECT MAX("IdViaje") FROM "Viajes"));

COMMIT;

