-- ============================================================
-- SEED INICIAL
-- ============================================================
--
-- StudyGoAbroad - PostgreSQL (Supabase)
-- Convertido desde ER/Studio 8.0 (MySQL 5.x)
--

SET search_path TO public;
SET client_encoding TO 'UTF8';
SET timezone TO 'UTC';
SET datestyle TO 'ISO, DMY';

BEGIN;


DROP TABLE IF EXISTS "Viajes" CASCADE;
DROP TABLE IF EXISTS "Vuelos" CASCADE;
DROP TABLE IF EXISTS "Pagos" CASCADE;
DROP TABLE IF EXISTS "Pasajeros" CASCADE;
DROP TABLE IF EXISTS "Pasaportes" CASCADE;
DROP TABLE IF EXISTS "Institucion" CASCADE;
DROP TABLE IF EXISTS "Programa" CASCADE;
DROP TABLE IF EXISTS "Usuarios" CASCADE;
DROP TABLE IF EXISTS "Aeropuetos" CASCADE;
DROP TABLE IF EXISTS "Ciudades" CASCADE;
DROP TABLE IF EXISTS "Paises" CASCADE;
DROP TABLE IF EXISTS "Provincias" CASCADE;
DROP TABLE IF EXISTS "Roles" CASCADE;
DROP TABLE IF EXISTS "TiposProgramas" CASCADE;

--
-- TABLAS
--

CREATE TABLE "Aeropuetos"(
    "IdAeropuerto"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Aeropuerto"      VARCHAR(120)    NOT NULL,
    PRIMARY KEY ("IdAeropuerto")
);

CREATE TABLE "Ciudades"(
    "IdCiudad"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Ciudad"      VARCHAR(100)    NOT NULL,
    PRIMARY KEY ("IdCiudad")
);

CREATE TABLE "Institucion"(
    "IdInstitucion"    INT GENERATED BY DEFAULT AS IDENTITY,
    "IdCiudad"         INT             NOT NULL,
    "IdProvincia"      INT             NOT NULL,
    "IdPais"           INT             NOT NULL,
    "Institucion"      VARCHAR(100)    NOT NULL,
    "Estado"           CHAR(1)         NOT NULL,
    PRIMARY KEY ("IdInstitucion")
);

CREATE TABLE "Pagos"(
    "IdPago"          INT GENERATED BY DEFAULT AS IDENTITY,
    "IdPasajero"      INT               NOT NULL,
    "NumeroCuota"     INT               NOT NULL,
    "MontoAbonado"    DECIMAL(15, 2)    NOT NULL,
    "FechaPago"       TIMESTAMP         NOT NULL,
    PRIMARY KEY ("IdPago", "IdPasajero")
);

CREATE TABLE "Paises"(
    "IdPais"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Pais"      VARCHAR(50)    NOT NULL,
    PRIMARY KEY ("IdPais")
);

CREATE TABLE "Pasajeros"(
    "IdPasajero"         INT GENERATED BY DEFAULT AS IDENTITY,
    "IdFactura"          VARCHAR(100)    NOT NULL,
    "IdPasaporte"        INT,
    "IdProvincia"        INT             NOT NULL,
    "IdCiudad"           INT             NOT NULL,
    "IdInstitucion"      INT             NOT NULL,
    "Nombres"            VARCHAR(30)     NOT NULL,
    "Apellido"           VARCHAR(30)     NOT NULL,
    "DNI"                VARCHAR(8)      NOT NULL,
    "FechaNacimiento"    DATE            NOT NULL,
    "Nacionalidad"       VARCHAR(30)     NOT NULL,
    "Domicilio"          VARCHAR(120)    NOT NULL,
    "Email"              VARCHAR(120)    NOT NULL,
    "Alergia"            VARCHAR(120),
    "Dieta"              VARCHAR(120),
    "Estado"             CHAR(1)         NOT NULL,
    PRIMARY KEY ("IdPasajero")
);

CREATE TABLE "Pasaportes"(
    "IdPasaporte"         INT GENERATED BY DEFAULT AS IDENTITY,
    "PaisEmisor"          INT           NOT NULL,
    "NumeroPasaporte"     VARCHAR(9)    NOT NULL,
    "FechaVencimiento"    DATE          NOT NULL,
    "FechaEmision"        DATE          NOT NULL,
    "Estado"              CHAR(1)       NOT NULL,
    PRIMARY KEY ("IdPasaporte")
);

CREATE TABLE "Programa"(
    "IdPrograma"              INT GENERATED BY DEFAULT AS IDENTITY,
    "IdTipoPrograma"          INT               NOT NULL,
    "PaisExcursion"           INT               NOT NULL,
    "PaisDestino"             INT               NOT NULL,
    "NombrePrograma"          VARCHAR(50)       NOT NULL,
    "DuracionPrograma"        INT               NOT NULL,
    "MontoTotalViaje"         DECIMAL(15, 2)    NOT NULL,
    "InstitucionReceptora"    VARCHAR(100)      NOT NULL,
    "Estado"                  CHAR(1)           NOT NULL,
    PRIMARY KEY ("IdPrograma")
);

CREATE TABLE "Provincias"(
    "IdProvincia"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Provincia"      VARCHAR(20)    NOT NULL,
    PRIMARY KEY ("IdProvincia")
);

CREATE TABLE "Roles"(
    "IdRol"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Rol"      VARCHAR(20)    NOT NULL,
    PRIMARY KEY ("IdRol")
);

CREATE TABLE "TiposProgramas"(
    "IdTipoPrograma"    INT            NOT NULL,
    "TipoPrograma"      VARCHAR(20)    NOT NULL,
    PRIMARY KEY ("IdTipoPrograma")
);

CREATE TABLE "Usuarios"(
    "IdUsuario"    INT GENERATED BY DEFAULT AS IDENTITY,
    "IdRol"        INT             NOT NULL,
    "Usuario"      VARCHAR(20)     NOT NULL,
    "Token"        VARCHAR(512)    NOT NULL,
    "Password"     CHAR(60)        NOT NULL,
    PRIMARY KEY ("IdUsuario")
);

CREATE TABLE "Viajes"(
    "IdViaje"               INT GENERATED BY DEFAULT AS IDENTITY,
    "IdPasajero"            INT    NOT NULL,
    "IdPrograma"            INT    NOT NULL,
    "VueloInternacional"    INT    NOT NULL,
    "VueloNacional"         INT,
    PRIMARY KEY ("IdViaje", "IdPasajero", "IdPrograma")
);

CREATE TABLE "Vuelos"(
    "IdVuelo"              INT GENERATED BY DEFAULT AS IDENTITY,
    "AeropuertoOrigen"     INT          NOT NULL,
    "AeropuertoDestino"    INT          NOT NULL,
    "NumeroVuelo"          CHAR(9)      NOT NULL,
    "TipoVuelo"            CHAR(1)      NOT NULL,
    "Fecha"                TIMESTAMP    NOT NULL,
    PRIMARY KEY ("IdVuelo")
);

--
-- INDICES
--

CREATE UNIQUE INDEX "UI_Aeropuerto" ON "Aeropuetos"("Aeropuerto");
CREATE UNIQUE INDEX "UI_Ciudad" ON "Ciudades"("Ciudad");

CREATE UNIQUE INDEX "UI_Institucion" ON "Institucion"("Institucion");
CREATE INDEX "Ref38" ON "Institucion"("IdCiudad");
CREATE INDEX "Ref59" ON "Institucion"("IdProvincia");
CREATE INDEX "Ref810" ON "Institucion"("IdPais");

CREATE INDEX "Ref113" ON "Pagos"("IdPasajero");

CREATE UNIQUE INDEX "UI_Pais" ON "Paises"("Pais");

-- IE_IdFactura se omite: UI_IdFactura ya indexa la misma columna
CREATE UNIQUE INDEX "UI_DNI" ON "Pasajeros"("DNI");
CREATE UNIQUE INDEX "UI_Email" ON "Pasajeros"("Email");
CREATE UNIQUE INDEX "UI_IdFactura" ON "Pasajeros"("IdFactura");
CREATE INDEX "Ref51" ON "Pasajeros"("IdProvincia");
CREATE INDEX "Ref32" ON "Pasajeros"("IdCiudad");
CREATE INDEX "Ref411" ON "Pasajeros"("IdInstitucion");
CREATE INDEX "Ref221" ON "Pasajeros"("IdPasaporte");

CREATE UNIQUE INDEX "UI_NumeroPasaporte" ON "Pasaportes"("NumeroPasaporte");
CREATE INDEX "Ref822" ON "Pasaportes"("PaisEmisor");

CREATE UNIQUE INDEX "UI_NombrePrograma" ON "Programa"("NombrePrograma");
CREATE INDEX "Ref83" ON "Programa"("PaisDestino");
CREATE INDEX "Ref85" ON "Programa"("PaisExcursion");
CREATE INDEX "Ref1723" ON "Programa"("IdTipoPrograma");

CREATE UNIQUE INDEX "UI_Provincias" ON "Provincias"("Provincia");
CREATE UNIQUE INDEX "UI_TipoPrograma" ON "TiposProgramas"("TipoPrograma");

CREATE UNIQUE INDEX "UI_Usuario" ON "Usuarios"("Usuario");
CREATE INDEX "Ref1520" ON "Usuarios"("IdRol");

CREATE INDEX "Ref112" ON "Viajes"("IdPasajero");
CREATE INDEX "Ref914" ON "Viajes"("IdPrograma");
CREATE INDEX "Ref1115" ON "Viajes"("VueloInternacional");
CREATE INDEX "Ref1116" ON "Viajes"("VueloNacional");

CREATE INDEX "Ref1218" ON "Vuelos"("AeropuertoOrigen");
CREATE INDEX "Ref1219" ON "Vuelos"("AeropuertoDestino");

--
-- CLAVES FORANEAS
--

ALTER TABLE "Institucion" ADD CONSTRAINT "RefCiudades8"
    FOREIGN KEY ("IdCiudad") REFERENCES "Ciudades"("IdCiudad");
ALTER TABLE "Institucion" ADD CONSTRAINT "RefProvincias9"
    FOREIGN KEY ("IdProvincia") REFERENCES "Provincias"("IdProvincia");
ALTER TABLE "Institucion" ADD CONSTRAINT "RefPaises10"
    FOREIGN KEY ("IdPais") REFERENCES "Paises"("IdPais");

ALTER TABLE "Pagos" ADD CONSTRAINT "RefPasajeros13"
    FOREIGN KEY ("IdPasajero") REFERENCES "Pasajeros"("IdPasajero");

ALTER TABLE "Pasajeros" ADD CONSTRAINT "RefProvincias1"
    FOREIGN KEY ("IdProvincia") REFERENCES "Provincias"("IdProvincia");
ALTER TABLE "Pasajeros" ADD CONSTRAINT "RefCiudades2"
    FOREIGN KEY ("IdCiudad") REFERENCES "Ciudades"("IdCiudad");
ALTER TABLE "Pasajeros" ADD CONSTRAINT "RefInstitucion11"
    FOREIGN KEY ("IdInstitucion") REFERENCES "Institucion"("IdInstitucion");
ALTER TABLE "Pasajeros" ADD CONSTRAINT "RefPasaportes21"
    FOREIGN KEY ("IdPasaporte") REFERENCES "Pasaportes"("IdPasaporte");

ALTER TABLE "Pasaportes" ADD CONSTRAINT "RefPaises22"
    FOREIGN KEY ("PaisEmisor") REFERENCES "Paises"("IdPais");

ALTER TABLE "Programa" ADD CONSTRAINT "RefPaises3"
    FOREIGN KEY ("PaisDestino") REFERENCES "Paises"("IdPais");
ALTER TABLE "Programa" ADD CONSTRAINT "RefPaises5"
    FOREIGN KEY ("PaisExcursion") REFERENCES "Paises"("IdPais");
ALTER TABLE "Programa" ADD CONSTRAINT "RefTiposProgramas23"
    FOREIGN KEY ("IdTipoPrograma") REFERENCES "TiposProgramas"("IdTipoPrograma");

ALTER TABLE "Usuarios" ADD CONSTRAINT "RefRoles20"
    FOREIGN KEY ("IdRol") REFERENCES "Roles"("IdRol");

ALTER TABLE "Viajes" ADD CONSTRAINT "RefPasajeros12"
    FOREIGN KEY ("IdPasajero") REFERENCES "Pasajeros"("IdPasajero");
ALTER TABLE "Viajes" ADD CONSTRAINT "RefPrograma14"
    FOREIGN KEY ("IdPrograma") REFERENCES "Programa"("IdPrograma");
ALTER TABLE "Viajes" ADD CONSTRAINT "RefVuelos15"
    FOREIGN KEY ("VueloInternacional") REFERENCES "Vuelos"("IdVuelo");
ALTER TABLE "Viajes" ADD CONSTRAINT "RefVuelos16"
    FOREIGN KEY ("VueloNacional") REFERENCES "Vuelos"("IdVuelo");

ALTER TABLE "Vuelos" ADD CONSTRAINT "RefAeropuetos18"
    FOREIGN KEY ("AeropuertoOrigen") REFERENCES "Aeropuetos"("IdAeropuerto");
ALTER TABLE "Vuelos" ADD CONSTRAINT "RefAeropuetos19"
    FOREIGN KEY ("AeropuertoDestino") REFERENCES "Aeropuetos"("IdAeropuerto");