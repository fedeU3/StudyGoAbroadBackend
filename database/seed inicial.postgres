-- ============================================================
-- SEED INICIAL
-- ============================================================
--
-- StudyGoAbroad - PostgreSQL (Supabase)
-- Convertido desde ER/Studio 8.0 (MySQL 5.x)
--

SET search_path TO public;
SET client_encoding TO 'UTF8';
SET timezone TO 'UTC';
SET datestyle TO 'ISO, DMY';

BEGIN;


DROP TABLE IF EXISTS public."Viajes" CASCADE;
DROP TABLE IF EXISTS public."Vuelos" CASCADE;
DROP TABLE IF EXISTS public."Pagos" CASCADE;
DROP TABLE IF EXISTS public."MediosDePago" CASCADE;
DROP TABLE IF EXISTS public."Pasajeros" CASCADE;
DROP TABLE IF EXISTS public."Pasaportes" CASCADE;
DROP TABLE IF EXISTS public."Institucion" CASCADE;
DROP TABLE IF EXISTS public."Programa" CASCADE;
DROP TABLE IF EXISTS public."Usuarios" CASCADE;
DROP TABLE IF EXISTS public."Aeropuetos" CASCADE;
DROP TABLE IF EXISTS public."Ciudades" CASCADE;
DROP TABLE IF EXISTS public."Paises" CASCADE;
DROP TABLE IF EXISTS public."Provincias" CASCADE;
DROP TABLE IF EXISTS public."Roles" CASCADE;
DROP TABLE IF EXISTS public."TiposProgramas" CASCADE;

--
-- TABLAS
--

CREATE TABLE public."Aeropuetos"(
    "IdAeropuerto"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Aeropuerto"      VARCHAR(120)    NOT NULL,
    PRIMARY KEY ("IdAeropuerto")
);

CREATE TABLE public."Ciudades"(
    "IdCiudad"       INT GENERATED BY DEFAULT AS IDENTITY,
    "IdProvincia"    INT             NOT NULL,
    "Ciudad"         VARCHAR(100)    NOT NULL,
    PRIMARY KEY ("IdCiudad", "IdProvincia")
);

CREATE TABLE public."Institucion"(
    "IdInstitucion"    INT GENERATED BY DEFAULT AS IDENTITY,
    "IdCiudad"         INT             NOT NULL,
    "IdProvincia"      INT             NOT NULL,
    "IdPais"           INT             NOT NULL,
    "Institucion"      VARCHAR(100)    NOT NULL,
    "Estado"           CHAR(1)         NOT NULL,
    PRIMARY KEY ("IdInstitucion")
);

CREATE TABLE public."MediosDePago"(
    "IdMedioDePago"    INT GENERATED BY DEFAULT AS IDENTITY,
    "MedioDePago"      VARCHAR(30)    NOT NULL,
    "Estado"           CHAR(1),
    PRIMARY KEY ("IdMedioDePago")
);

CREATE TABLE public."Pagos"(
    "IdPago"           INT GENERATED BY DEFAULT AS IDENTITY,
    "IdPasajero"       INT               NOT NULL,
    "IdMedioDePago"    INT               NOT NULL,
    "NumeroCuota"      INT               NOT NULL,
    "MontoAbonado"     DECIMAL(15, 2)    NOT NULL,
    "FechaPago"        TIMESTAMP         NOT NULL,
    PRIMARY KEY ("IdPago", "IdPasajero")
);

CREATE TABLE public."Paises"(
    "IdPais"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Pais"      VARCHAR(50)    NOT NULL,
    PRIMARY KEY ("IdPais")
);

CREATE TABLE public."Pasajeros"(
    "IdPasajero"         INT GENERATED BY DEFAULT AS IDENTITY,
    "IdFactura"          VARCHAR(100)    NOT NULL,
    "IdPasaporte"        INT,
    "IdProvincia"        INT             NOT NULL,
    "IdCiudad"           INT             NOT NULL,
    "IdInstitucion"      INT             NOT NULL,
    "Nombres"            VARCHAR(30)     NOT NULL,
    "Apellido"           VARCHAR(30)     NOT NULL,
    "DNI"                VARCHAR(8)      NOT NULL,
    "FechaNacimiento"    DATE            NOT NULL,
    "Nacionalidad"       VARCHAR(30)     NOT NULL,
    "Domicilio"          VARCHAR(120)    NOT NULL,
    "Email"              VARCHAR(120)    NOT NULL,
    "Alergia"            VARCHAR(120),
    "Dieta"              VARCHAR(120),
    "Estado"             CHAR(1)         NOT NULL,
    PRIMARY KEY ("IdPasajero")
);

CREATE TABLE public."Pasaportes"(
    "IdPasaporte"         INT GENERATED BY DEFAULT AS IDENTITY,
    "PaisEmisor"          INT           NOT NULL,
    "NumeroPasaporte"     VARCHAR(9)    NOT NULL,
    "FechaVencimiento"    DATE          NOT NULL,
    "FechaEmision"        DATE          NOT NULL,
    "Estado"              CHAR(1)       NOT NULL,
    PRIMARY KEY ("IdPasaporte")
);

CREATE TABLE public."Programa"(
    "IdPrograma"              INT GENERATED BY DEFAULT AS IDENTITY,
    "IdTipoPrograma"          INT               NOT NULL,
    "PaisExcursion"           INT               NOT NULL,
    "PaisDestino"             INT               NOT NULL,
    "NombrePrograma"          VARCHAR(50)       NOT NULL,
    "DuracionPrograma"        INT               NOT NULL,
    "MontoTotalViaje"         DECIMAL(15, 2)    NOT NULL,
    "InstitucionReceptora"    VARCHAR(100)      NOT NULL,
    "Estado"                  CHAR(1)           NOT NULL,
    PRIMARY KEY ("IdPrograma")
);

CREATE TABLE public."Provincias"(
    "IdProvincia"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Provincia"      VARCHAR(20)    NOT NULL,
    PRIMARY KEY ("IdProvincia")
);

CREATE TABLE public."Roles"(
    "IdRol"    INT GENERATED BY DEFAULT AS IDENTITY,
    "Rol"      VARCHAR(20)    NOT NULL,
    PRIMARY KEY ("IdRol")
);

CREATE TABLE public."TiposProgramas"(
    "IdTipoPrograma"    INT            NOT NULL,
    "TipoPrograma"      VARCHAR(20)    NOT NULL,
    PRIMARY KEY ("IdTipoPrograma")
);

CREATE TABLE public."Usuarios"(
    "IdUsuario"    INT GENERATED BY DEFAULT AS IDENTITY,
    "IdRol"        INT             NOT NULL,
    "Usuario"      VARCHAR(20)     NOT NULL,
    "Token"        VARCHAR(512)    NOT NULL,
    "Password"     CHAR(60)        NOT NULL,
    PRIMARY KEY ("IdUsuario")
);

CREATE TABLE public."Viajes"(
    "IdViaje"               INT GENERATED BY DEFAULT AS IDENTITY,
    "IdPasajero"            INT    NOT NULL,
    "IdPrograma"            INT    NOT NULL,
    "VueloInternacional"    INT    NOT NULL,
    "VueloNacional"         INT,
    PRIMARY KEY ("IdViaje", "IdPasajero", "IdPrograma")
);

CREATE TABLE public."Vuelos"(
    "IdVuelo"              INT GENERATED BY DEFAULT AS IDENTITY,
    "AeropuertoOrigen"     INT          NOT NULL,
    "AeropuertoDestino"    INT          NOT NULL,
    "NumeroVuelo"          CHAR(9)      NOT NULL,
    "TipoVuelo"            CHAR(1)      NOT NULL,
    "Fecha"                TIMESTAMP    NOT NULL,
    PRIMARY KEY ("IdVuelo")
);

--
-- INDICES
--

CREATE UNIQUE INDEX "UI_Aeropuerto" ON public."Aeropuetos"("Aeropuerto");
CREATE UNIQUE INDEX "UI_Ciudad" ON public."Ciudades"("Ciudad");
CREATE INDEX "Ref526" ON public."Ciudades"("IdProvincia");

CREATE UNIQUE INDEX "UI_Institucion" ON public."Institucion"("Institucion");
CREATE INDEX "Ref38" ON public."Institucion"("IdCiudad", "IdProvincia");
CREATE INDEX "Ref59" ON public."Institucion"("IdProvincia");
CREATE INDEX "Ref810" ON public."Institucion"("IdPais");

CREATE INDEX "Ref113" ON public."Pagos"("IdPasajero");
CREATE INDEX "Ref1927" ON public."Pagos"("IdMedioDePago");

CREATE UNIQUE INDEX "UI_Pais" ON public."Paises"("Pais");

-- IE_IdFactura se omite: UI_IdFactura ya indexa la misma columna
CREATE UNIQUE INDEX "UI_DNI" ON public."Pasajeros"("DNI");
CREATE UNIQUE INDEX "UI_Email" ON public."Pasajeros"("Email");
CREATE UNIQUE INDEX "UI_IdFactura" ON public."Pasajeros"("IdFactura");
CREATE INDEX "Ref51" ON public."Pasajeros"("IdProvincia");
CREATE INDEX "Ref32" ON public."Pasajeros"("IdCiudad", "IdProvincia");
CREATE INDEX "Ref411" ON public."Pasajeros"("IdInstitucion");
CREATE INDEX "Ref221" ON public."Pasajeros"("IdPasaporte");

CREATE UNIQUE INDEX "UI_NumeroPasaporte" ON public."Pasaportes"("NumeroPasaporte");
CREATE INDEX "Ref822" ON public."Pasaportes"("PaisEmisor");

CREATE UNIQUE INDEX "UI_NombrePrograma" ON public."Programa"("NombrePrograma");
CREATE INDEX "Ref83" ON public."Programa"("PaisDestino");
CREATE INDEX "Ref85" ON public."Programa"("PaisExcursion");
CREATE INDEX "Ref1723" ON public."Programa"("IdTipoPrograma");

CREATE UNIQUE INDEX "UI_Provincias" ON public."Provincias"("Provincia");
CREATE UNIQUE INDEX "UI_TipoPrograma" ON public."TiposProgramas"("TipoPrograma");

CREATE UNIQUE INDEX "UI_Usuario" ON public."Usuarios"("Usuario");
CREATE INDEX "Ref1520" ON public."Usuarios"("IdRol");

CREATE INDEX "Ref112" ON public."Viajes"("IdPasajero");
CREATE INDEX "Ref914" ON public."Viajes"("IdPrograma");
CREATE INDEX "Ref1115" ON public."Viajes"("VueloInternacional");
CREATE INDEX "Ref1116" ON public."Viajes"("VueloNacional");

CREATE INDEX "Ref1218" ON public."Vuelos"("AeropuertoOrigen");
CREATE INDEX "Ref1219" ON public."Vuelos"("AeropuertoDestino");

--
-- CLAVES FORANEAS
--

ALTER TABLE public."Ciudades" ADD CONSTRAINT "RefProvincias26"
    FOREIGN KEY ("IdProvincia") REFERENCES public."Provincias"("IdProvincia");

ALTER TABLE public."Institucion" ADD CONSTRAINT "RefCiudades8"
    FOREIGN KEY ("IdCiudad", "IdProvincia") REFERENCES public."Ciudades"("IdCiudad", "IdProvincia");
ALTER TABLE public."Institucion" ADD CONSTRAINT "RefProvincias9"
    FOREIGN KEY ("IdProvincia") REFERENCES public."Provincias"("IdProvincia");
ALTER TABLE public."Institucion" ADD CONSTRAINT "RefPaises10"
    FOREIGN KEY ("IdPais") REFERENCES public."Paises"("IdPais");

ALTER TABLE public."Pagos" ADD CONSTRAINT "RefPasajeros13"
    FOREIGN KEY ("IdPasajero") REFERENCES public."Pasajeros"("IdPasajero");
ALTER TABLE public."Pagos" ADD CONSTRAINT "RefMediosDePago27"
    FOREIGN KEY ("IdMedioDePago") REFERENCES public."MediosDePago"("IdMedioDePago");

ALTER TABLE public."Pasajeros" ADD CONSTRAINT "RefProvincias1"
    FOREIGN KEY ("IdProvincia") REFERENCES public."Provincias"("IdProvincia");
-- ER/Studio genera ("IdProvincia", "IdCiudad") y cruza las columnas: se alinea con la PK de "Ciudades"
ALTER TABLE public."Pasajeros" ADD CONSTRAINT "RefCiudades2"
    FOREIGN KEY ("IdCiudad", "IdProvincia") REFERENCES public."Ciudades"("IdCiudad", "IdProvincia");
ALTER TABLE public."Pasajeros" ADD CONSTRAINT "RefInstitucion11"
    FOREIGN KEY ("IdInstitucion") REFERENCES public."Institucion"("IdInstitucion");
ALTER TABLE public."Pasajeros" ADD CONSTRAINT "RefPasaportes21"
    FOREIGN KEY ("IdPasaporte") REFERENCES public."Pasaportes"("IdPasaporte");

ALTER TABLE public."Pasaportes" ADD CONSTRAINT "RefPaises22"
    FOREIGN KEY ("PaisEmisor") REFERENCES public."Paises"("IdPais");

ALTER TABLE public."Programa" ADD CONSTRAINT "RefPaises3"
    FOREIGN KEY ("PaisDestino") REFERENCES public."Paises"("IdPais");
ALTER TABLE public."Programa" ADD CONSTRAINT "RefPaises5"
    FOREIGN KEY ("PaisExcursion") REFERENCES public."Paises"("IdPais");
ALTER TABLE public."Programa" ADD CONSTRAINT "RefTiposProgramas23"
    FOREIGN KEY ("IdTipoPrograma") REFERENCES public."TiposProgramas"("IdTipoPrograma");

ALTER TABLE public."Usuarios" ADD CONSTRAINT "RefRoles20"
    FOREIGN KEY ("IdRol") REFERENCES public."Roles"("IdRol");

ALTER TABLE public."Viajes" ADD CONSTRAINT "RefPasajeros12"
    FOREIGN KEY ("IdPasajero") REFERENCES public."Pasajeros"("IdPasajero");
ALTER TABLE public."Viajes" ADD CONSTRAINT "RefPrograma14"
    FOREIGN KEY ("IdPrograma") REFERENCES public."Programa"("IdPrograma");
ALTER TABLE public."Viajes" ADD CONSTRAINT "RefVuelos15"
    FOREIGN KEY ("VueloInternacional") REFERENCES public."Vuelos"("IdVuelo");
ALTER TABLE public."Viajes" ADD CONSTRAINT "RefVuelos16"
    FOREIGN KEY ("VueloNacional") REFERENCES public."Vuelos"("IdVuelo");

ALTER TABLE public."Vuelos" ADD CONSTRAINT "RefAeropuetos18"
    FOREIGN KEY ("AeropuertoOrigen") REFERENCES public."Aeropuetos"("IdAeropuerto");
ALTER TABLE public."Vuelos" ADD CONSTRAINT "RefAeropuetos19"
    FOREIGN KEY ("AeropuertoDestino") REFERENCES public."Aeropuetos"("IdAeropuerto");

COMMIT;